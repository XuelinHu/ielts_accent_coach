# Cloud ASR requires DashScope. Chat can use the same key or a server-side LAN endpoint.
DASHSCOPE_API_KEY=replace-with-your-model-studio-api-key
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
PORT=8041
DB_HOST=192.168.1.9
DB_PORT=5433
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=ielts_accent_lab
DB_SSL=false
DB_BACKUP_ENCRYPTION_KEY=

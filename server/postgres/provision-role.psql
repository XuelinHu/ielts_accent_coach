\set ON_ERROR_STOP on
\set default_database 'ielts_accent_lab'
\set default_role 'ielts_accent_lab_app'
\prompt 'Project database name [ielts_accent_lab]: ' requested_database
\prompt 'Project runtime role [ielts_accent_lab_app]: ' requested_role

SELECT COALESCE(NULLIF(:'requested_database', ''), :'default_database') AS app_database \gset
SELECT COALESCE(NULLIF(:'requested_role', ''), :'default_role') AS app_role \gset
SELECT CASE WHEN :'app_database' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;
SELECT CASE WHEN :'app_role' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;

SELECT format($sql$DO $body$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_database WHERE datname = %L
    AND pg_get_userbyid(datdba) IS DISTINCT FROM %L) THEN
    RAISE EXCEPTION 'Database exists with a different owner; inspect and migrate it explicitly';
  END IF;
END $body$;$sql$, :'app_database', :'app_role')\gexec

SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT', :'app_role')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_role')\gexec
SELECT format($sql$DO $body$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = %L
    AND (rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls)) THEN
    RAISE EXCEPTION 'Existing runtime role has elevated privileges; inspect it before provisioning';
  END IF;
END $body$;$sql$, :'app_role')\gexec
\password :app_role

SELECT format('CREATE DATABASE %I OWNER %I ENCODING %L TEMPLATE template0', :'app_database', :'app_role', 'UTF8')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_database')\gexec
SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'app_database')\gexec
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO %I', :'app_database', :'app_role')\gexec
\echo 'IELTS project database and restricted runtime role are ready.'

{
  "name": "ielts-accent-coach-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local secure proxy for the IELTS Accent Lab AI coach",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db:migrate": "node --env-file=.env migrate.js",
    "test": "node --test ../test/*.test.js",
    "test:integration": "node --env-file=.env --test ../test/postgres-api.integration.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
